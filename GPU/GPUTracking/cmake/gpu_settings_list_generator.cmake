# Generates the settings list header from the template: within each config block, the members are stable-sorted by alignment (8, 4, 2, 1 bytes), all other entries follow in their original order, comment lines are dropped
function(generate_gpu_settings_list INPUT OUTPUT)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${INPUT}")
  get_filename_component(INPUT_NAME "${INPUT}" NAME)
  file(READ "${INPUT}" CONTENT)
  string(REGEX REPLACE "\n$" "" CONTENT "${CONTENT}")
  string(REPLACE ";" "QCONFIG_CMAKE_INTERNAL_SEMICOLON" CONTENT "${CONTENT}") # Protect characters with special meaning in CMake lists
  string(REPLACE "[" "QCONFIG_CMAKE_INTERNAL_BRACKET_OPEN" CONTENT "${CONTENT}")
  string(REPLACE "]" "QCONFIG_CMAKE_INTERNAL_BRACKET_CLOSE" CONTENT "${CONTENT}")
  string(REPLACE "\n" ";" LINES "${CONTENT}")

  set(RESULT "// Generated by CMake from ${INPUT_NAME}, do not edit\n")
  set(BLOCK "")
  foreach(LINE IN LISTS LINES)
    string(REPLACE "QCONFIG_CMAKE_INTERNAL_SEMICOLON" ";" LINE_ORIG "${LINE}") # Only for error messages
    string(REPLACE "QCONFIG_CMAKE_INTERNAL_BRACKET_OPEN" "[" LINE_ORIG "${LINE_ORIG}")
    string(REPLACE "QCONFIG_CMAKE_INTERNAL_BRACKET_CLOSE" "]" LINE_ORIG "${LINE_ORIG}")
    if(BLOCK STREQUAL "")
      if(LINE MATCHES "^[ \t]*Begin(Sub|Hidden)?Config\\(([A-Za-z0-9_]+)")
        set(BLOCK "${CMAKE_MATCH_2}")
        foreach(ALIGN 8 4 2 1 OTHER)
          set(ENTRIES_${ALIGN} "")
        endforeach()
      endif()
      string(APPEND RESULT "${LINE}\n")
    elseif(LINE MATCHES "^[ \t]*#")
      message(FATAL_ERROR "${INPUT_NAME}: preprocessor directive in config block ${BLOCK} not supported, since the entries are reordered: ${LINE_ORIG}")
    elseif(LINE MATCHES "^[ \t]*//") # Comment lines would be detached from their entries by the reordering, drop them
    elseif(LINE MATCHES "^[ \t]*EndConfig\\(")
      string(APPEND RESULT "${ENTRIES_8}${ENTRIES_4}${ENTRIES_2}${ENTRIES_1}${ENTRIES_OTHER}${LINE}\n")
      set(BLOCK "")
    else()
      set(TYPE "")
      if(LINE MATCHES "^[ \t]*Add(Option|Variable)(RTC)?\\([A-Za-z0-9_]+,([^,]+),")
        set(TYPE "${CMAKE_MATCH_3}")
      elseif(LINE MATCHES "^[ \t]*AddOptionArray(RTC)?\\([A-Za-z0-9_]+,([^,]+),")
        set(TYPE "${CMAKE_MATCH_2}")
      elseif(LINE MATCHES "^[ \t]*AddOptionVec\\(")
        set(TYPE "std::vector")
      elseif(LINE MATCHES "^[ \t]*Add[A-Za-z]*\\(" AND NOT LINE MATCHES "^[ \t]*(AddOptionSet|AddSubConfig|AddHelp|AddHelpAll|AddHelpText|AddShortcut|AddCommand|AddCustomCPP)\\(")
        message(FATAL_ERROR "${INPUT_NAME}: unknown macro in config block ${BLOCK}, add it to generate_gpu_settings_list: ${LINE_ORIG}")
      endif()
      string(STRIP "${TYPE}" TYPE)
      if(TYPE STREQUAL "")
        set(ALIGN OTHER)
      elseif(TYPE MATCHES "\\*$" OR TYPE MATCHES "^(std::string|std::vector|double|int64_t|uint64_t|size_t)$")
        set(ALIGN 8)
      elseif(TYPE MATCHES "^(float|int32_t|uint32_t)$")
        set(ALIGN 4)
      elseif(TYPE MATCHES "^(int16_t|uint16_t)$")
        set(ALIGN 2)
      elseif(TYPE MATCHES "^(bool|char|int8_t|uint8_t)$")
        set(ALIGN 1)
      else()
        message(FATAL_ERROR "${INPUT_NAME}: unknown type ${TYPE} in config block ${BLOCK}, add it to generate_gpu_settings_list: ${LINE_ORIG}")
      endif()
      if(TYPE STREQUAL "bool" AND BLOCK MATCHES "^GPUSettingsRec")
        message(FATAL_ERROR "${INPUT_NAME}: bool is forbidden in config block ${BLOCK}, since sizeof(bool) is implementation-defined: ${LINE_ORIG}")
      endif()
      string(APPEND ENTRIES_${ALIGN} "${LINE}\n")
    endif()
  endforeach()
  if(NOT BLOCK STREQUAL "")
    message(FATAL_ERROR "${INPUT_NAME}: config block ${BLOCK} not terminated by EndConfig()")
  endif()

  string(REPLACE "QCONFIG_CMAKE_INTERNAL_SEMICOLON" ";" RESULT "${RESULT}")
  string(REPLACE "QCONFIG_CMAKE_INTERNAL_BRACKET_OPEN" "[" RESULT "${RESULT}")
  string(REPLACE "QCONFIG_CMAKE_INTERNAL_BRACKET_CLOSE" "]" RESULT "${RESULT}")
  if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD_RESULT)
  endif()
  if(NOT "${OLD_RESULT}" STREQUAL "${RESULT}") # Do not touch the file if unchanged, to avoid rebuilds
    file(WRITE "${OUTPUT}" "${RESULT}")
  endif()
endfunction()
