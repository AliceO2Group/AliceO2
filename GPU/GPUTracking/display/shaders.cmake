# Compiles a GLSL shader with glslc to SPIR-V for Vulkan (${CMAKE_CURRENT_BINARY_DIR}/vulkan/) and / or OpenGL (.../opengl/), depending on GPUCA_EVENT_DISPLAY_VULKAN / _OPENGL, and embeds it as binary resource.
# The shader sources use #ifdef VULKAN (defined by glslc for Vulkan targets) for API differences. The resource symbols are collected for write_glslc_shader_header.
function(add_glslc_shader TARGET SHADER)
  get_filename_component(input-file-abs ${SHADER} ABSOLUTE)
  get_filename_component(input-file-name ${SHADER} NAME)
  foreach(api vulkan opengl)
    string(TOUPPER ${api} api-upper)
    if(NOT GPUCA_EVENT_DISPLAY_${api-upper})
      continue()
    endif()
    if(api STREQUAL "vulkan")
      set(target-env vulkan1.4)
    else()
      set(target-env opengl4.5) # SPIR-V 1.0 for OpenGL 4.6 (ARB_gl_spirv)
    endif()
    set(spirv-file ${CMAKE_CURRENT_BINARY_DIR}/${api}/${input-file-name}.spv)
    file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/${api})
    add_custom_command(
      OUTPUT ${spirv-file}
      COMMAND ${GPUCA_GLSLC} --target-env=${target-env} -o ${spirv-file} ${input-file-abs} -MD -MT ${spirv-file} -MF ${spirv-file}.d
      DEPENDS ${input-file-abs}
      DEPFILE ${spirv-file}.d
      COMMENT "Compiling GLSL to SPIR-V (${api}): ${SHADER}"
      VERBATIM
    )
    add_binary_resource(${TARGET} ${spirv-file})
    string(MAKE_C_IDENTIFIER "${api}/${input-file-name}.spv" symbol) # Same name as the symbol created by ld --format binary
    set_property(GLOBAL APPEND PROPERTY GPUCA_DISPLAY_SHADER_SYMBOLS_${api} ${symbol})
  endforeach()
endfunction(add_glslc_shader)

# Generates the header declaring the symbols of all shaders added with add_glslc_shader (_binary_<api>_<file>_spv_start / _len), for the API selected by GPUCA_DISPLAY_SHADER_TYPE_VULKAN / _OPENGL, which the including file defines
function(write_glslc_shader_header TARGET HEADER)
  set(content "// Generated by GPU/GPUTracking/display/shaders.cmake, do not edit\n\n#include \"utils/qGetLdBinarySymbols.h\"\n\n")
  set(directive "#if")
  foreach(api vulkan opengl)
    get_property(symbols GLOBAL PROPERTY GPUCA_DISPLAY_SHADER_SYMBOLS_${api})
    if(NOT symbols)
      continue() # Not compiled for this API, falls through to the #error
    endif()
    string(TOUPPER ${api} api-upper)
    string(APPEND content "${directive} defined(GPUCA_DISPLAY_SHADER_TYPE_${api-upper})\n")
    set(directive "#elif")
    foreach(symbol ${symbols})
      string(APPEND content "QGET_LD_BINARY_SYMBOLS(${symbol});\n")
    endforeach()
  endforeach()
  if(directive STREQUAL "#if")
    string(APPEND content "#if 0\n")
  endif()
  string(APPEND content "#else\n#error GPUCA_DISPLAY_SHADER_TYPE_[VULKAN|OPENGL] undefined, or shaders not compiled for this type\n#endif\n")
  file(CONFIGURE OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${HEADER} CONTENT "${content}" @ONLY) # Only rewritten if changed
  target_include_directories(${TARGET} PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
endfunction(write_glslc_shader_header)
